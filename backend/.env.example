# LANscape Backend Environment Configuration
# Copy this file to .env to customize settings

# Host and Port for backend server
LANSCAPE_HOST=127.0.0.1
LANSCAPE_PORT=8000

# Target Gateway / Router IP to ping and monitor
LANSCAPE_ROUTER_IP=192.168.1.1

# Custom path to SQLite database (default: ../data/lanscape.db or ../data/homenet.db)
# LANSCAPE_DB_PATH=d:/codes/homenet/data/lanscape.db
