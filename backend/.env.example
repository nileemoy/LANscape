# HomeNet Backend Environment Configuration
# Copy this file to .env to customize settings

# Host and Port for backend server
HOMENET_HOST=127.0.0.1
HOMENET_PORT=8000

# Target Gateway / Router IP to ping and monitor
HOMENET_ROUTER_IP=192.168.1.1

# Custom path to SQLite database (default: ../data/homenet.db)
# HOMENET_DB_PATH=d:/codes/homenet/data/homenet.db

